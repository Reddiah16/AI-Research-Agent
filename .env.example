# AI Research Agent — environment configuration template.
#
# Copy this file to `.env` (git-ignored) and fill in your own values:
#     cp .env.example .env
#
# NEVER commit `.env` — it holds real credentials. Only this placeholder
# template is tracked.

# PostgreSQL connection string used by database/database.py (SQLAlchemy).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://<db_user>:<db_password>@<host>:5432/<database_name>

# --- Phase 2/3 research quality settings (optional; defaults shown) ----------
# Page fetching is best-effort and bounded. Disable with false.
ENABLE_PAGE_FETCH=true

# --- Phase 3 fetch safety and reliability (optional) -------------------------
# Hard cap on page fetches for the whole research run.
MAX_TOTAL_PAGES_PER_RUN=12
# Apply robots.txt rules to page fetches (fail-open if robots.txt is unreachable).
RESPECT_ROBOTS_TXT=true
# Resolve hostnames and reject private/loopback answers (DNS-rebinding mitigation).
ENFORCE_DNS_SAFETY=true
# Bounded DuckDuckGo retries. 0 = a single attempt.
SEARCH_MAX_RETRIES=2

# --- Phase 3 evaluation (optional) -------------------------------------------
# Token-coverage threshold at which a verified claim counts as lexically supported.
EVALUATION_SUPPORT_THRESHOLD=0.55
# Append-only JSONL evaluation records (only written when explicitly requested
# or through the application).
EVALUATION_RECORD_PATH=benchmarks/results/evaluation_records.jsonl
