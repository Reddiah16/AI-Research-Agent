# AI Research Agent — environment configuration template.
#
# Copy this file to `.env` (git-ignored) and fill in your own values:
#     cp .env.example .env
#
# NEVER commit `.env` — it holds real credentials. Only this placeholder
# template is tracked.

# PostgreSQL connection string used by database/database.py (SQLAlchemy).
# This is the only value read from the environment today; Ollama host, model
# and search settings are defaults in config/config.py.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://<db_user>:<db_password>@<host>:5432/<database_name>
